---
/**
 * Nosotros: bienvenida, servicios y atmósfera del alojamiento.
 */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import GalleryHighlights from '../components/islands/GalleryHighlights';
import MoodCards from '../components/islands/MoodCards';
import { galleryService } from '../lib/services';
import { AMENITIES } from '../data/amenities';

const gallery = await galleryService.getImages();

// Tarjetas de atmósfera: títulos + posiciones en la galería
// (la isla las refresca en vivo cuando cambian en /admin).
const MOOD_TITLES = ['Desconéctate', 'Relájate', 'Descubre'];
const MOOD_INDICES = [3, 15, 12];

const highlights = gallery.slice(0, 4);

const amenities = AMENITIES;
---

<Base
  title="Nosotros — Entremonte Cabañas"
  description="Conoce Entremonte Cabañas: un refugio natural en La Vega, Cundinamarca, pensado para desconectarte y relajarte."
>
  <PageHead title="Nosotros" current="Nosotros" />

  <!-- Bienvenida + servicios -->
  <section class="shell grid gap-12 py-14 md:grid-cols-2 md:py-20">
    <div>
      <span class="eyebrow">Bienvenidos</span>
      <h2 class="mt-3 text-3xl md:text-4xl">Te damos la bienvenida a Entremonte Cabañas</h2>
      <p class="mt-5 leading-relaxed">
        Gracias por elegir nuestro alojamiento. Esperamos que disfrutes de la tranquilidad y belleza que nos rodea.
        Estamos aquí para hacer tu estadía inolvidable.
      </p>
      <a
        href="https://www.booking.com/hotel/co/entremonte-cabanas.es.html"
        target="_blank"
        rel="noopener"
        class="btn btn-primary mt-8"
      >
        Reserva tu estadía
      </a>
    </div>

    <ul class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
      {
        amenities.map((amenity) => (
          <li class="flex items-start gap-2.5 text-sm">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span>{amenity}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Atmósfera -->
  <section class="shell pb-4">
    <MoodCards client:load images={gallery} indices={MOOD_INDICES} titles={MOOD_TITLES} />
  </section>

  <!-- Teaser galería -->
  <section class="shell py-14">
    <div class="section-head">
      <span class="eyebrow">Galería</span>
      <h2>Paisajes que hablan solos.</h2>
    </div>

    <GalleryHighlights client:load images={highlights} />

    <div class="mt-8 text-center">
      <a href="/gallery" class="btn btn-primary">Ver galería completa</a>
    </div>
  </section>
</Base>
