---
/** Tarjeta de cabaña reutilizable (index + listado). */
import type { Cabin } from '../lib/types';
import { formatCOP } from '../lib/pricing';

interface Props {
  cabin: Cabin;
}
const { cabin } = Astro.props;
const cover = cabin.images[0];
const previewServices = cabin.services.slice(0, 3);
const extraServices = cabin.services.length - previewServices.length;
---

<article class="group overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
  <a href={`/cabin/${cabin.id}`} class="block">
    <div class="relative aspect-[4/3] overflow-hidden bg-brand-100">
      {
        cover ? (
          <img
            src={cover}
            alt={cabin.name}
            loading="lazy"
            decoding="async"
            width="480"
            height="360"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-sm text-brand-500">
            Sin imagen
          </div>
        )
      }
      {
        !cabin.available && (
          <span class="absolute left-3 top-3 rounded-full bg-ink-900/80 px-3 py-1 text-xs font-semibold text-white">
            No disponible
          </span>
        )
      }
    </div>

    <div class="p-5">
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="text-lg transition group-hover:text-brand-500">{cabin.name}</h3>
        <p class="shrink-0 text-right">
          {
            cabin.priceWeekday !== null && cabin.priceWeekend !== null ? (
              <>
                <span class="text-lg font-semibold text-brand-600">{formatCOP(cabin.priceWeekday)}</span>
                <span class="block text-[11px] uppercase tracking-wide text-ink-500">entre semana</span>
                <span class="block text-[11px] text-ink-400">
                  {formatCOP(cabin.priceWeekend)} fines y festivos
                </span>
              </>
            ) : (
              <span class="text-sm text-ink-500">Consultar tarifa</span>
            )
          }
        </p>
      </div>

      <p class="mt-2 flex items-center gap-1.5 text-sm text-ink-500">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
        Hasta {cabin.capacity} {cabin.capacity === 1 ? 'persona' : 'personas'}
      </p>

      {
        previewServices.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {previewServices.map((service) => (
              <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[11px] font-medium text-brand-600">
                {service}
              </span>
            ))}
            {extraServices > 0 && (
              <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[11px] font-medium text-brand-600">
                +{extraServices}
              </span>
            )}
          </div>
        )
      }

      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-500">
        Ver detalle
        <svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </a>
</article>
