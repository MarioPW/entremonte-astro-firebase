---
/**
 * Cabecera del sitio: barra superior de contacto + navegación principal.
 * Menú móvil con toggle vanilla (sin dependencias).
 */
import AdminNavLink from './islands/AdminNavLink';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/cabins', label: 'Cabañas' },
  { href: '/about-us', label: 'Nosotros' },
  { href: '/gallery', label: 'Galería' },
  { href: '/contact', label: 'Contáctanos' },
];

const isCurrent = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-brand-100 bg-white/95 backdrop-blur">
  <!-- Barra superior de contacto -->
  <div class="hidden bg-brand-700 text-white md:block">
    <div class="shell flex items-center justify-between py-1.5 text-xs">
      <ul class="flex items-center gap-5">
        <li class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293a.75.75 0 0 1-.92.246 12.05 12.05 0 0 1-5.476-5.476.75.75 0 0 1 .246-.92l1.293-.97c.362-.271.527-.734.417-1.173L6.72 3.102A1.125 1.125 0 0 0 5.628 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          (+57) 313 2839584
        </li>
        <li class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          entremonte.cabañas@gmail.com
        </li>
      </ul>
      <div class="flex items-center gap-3">
        <a
          href="https://www.facebook.com/p/Entremonte-Caba%C3%B1as-100083511781197/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg class="h-3.5 w-3.5 hover:text-accent-400" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073Z"/></svg>
        </a>
        <a href="https://wa.me/573132839584" target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg class="h-3.5 w-3.5 hover:text-accent-400" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
        <a
          href="https://www.booking.com/hotel/co/entremonte-cabanas.es.html"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Booking.com"
        >
          <svg class="h-3.5 w-3.5 hover:text-accent-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M4 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H4Zm3.2 3.5h4.3c2.4 0 3.9 1.2 3.9 3.1 0 1.3-.7 2.2-1.8 2.6 1.4.4 2.2 1.5 2.2 3 0 2.2-1.7 3.5-4.4 3.5H6V6.7c0-.7.5-1.2 1.2-1.2Zm1.4 2.1v2.6h2.4c1.1 0 1.8-.5 1.8-1.3 0-.8-.7-1.3-1.8-1.3H8.6Zm0 4.6v3.2h2.7c1.2 0 1.9-.6 1.9-1.6 0-1-.7-1.6-1.9-1.6H8.6Zm10.2 5.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/></svg>
        </a>
        <a href="https://www.instagram.com/entremonte_cabanas/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg class="h-3.5 w-3.5 hover:text-accent-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069Zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324Zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Navegación -->
  <div class="shell flex items-center justify-between py-3">
    <a href="/" class="flex items-center gap-3">
      <img src="/img/entremonte-logo.png" alt="Entremonte Cabañas" class="h-12 w-auto" width="60" height="48" />
      <span class="hidden font-display text-lg font-semibold text-ink-900 sm:block">Entremonte Cabañas</span>
    </a>

    <nav class="hidden lg:block" aria-label="Principal">
      <ul class="flex items-center gap-7 text-sm font-medium">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition hover:text-brand-500',
                  isCurrent(link.href) ? 'text-brand-500' : 'text-ink-700',
                ]}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <AdminNavLink current={isCurrent('/admin')} client:load />
      <a
        href="https://www.booking.com/hotel/co/entremonte-cabanas.es.html"
        target="_blank"
        rel="noopener"
        class="btn btn-accent hidden sm:inline-flex"
      >
        Reservar
      </a>

      <!-- Toggle menú móvil -->
      <button
        type="button"
        id="nav-toggle"
        class="rounded-lg p-2 text-ink-900 hover:bg-brand-50 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <nav id="mobile-nav" class="hidden border-t border-brand-100 bg-white lg:hidden" aria-label="Menú móvil">
    <ul class="shell flex flex-col gap-1 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium hover:bg-brand-50',
                isCurrent(link.href) ? 'bg-brand-50 text-brand-500' : 'text-ink-700',
              ]}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2">
        <a
          href="https://www.booking.com/hotel/co/entremonte-cabanas.es.html"
          target="_blank"
          rel="noopener"
          class="btn btn-accent w-full"
        >
          Reservar en Booking.com
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
