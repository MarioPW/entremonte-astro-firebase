---
/** Estrellas de calificación (1–5). */
interface Props {
  rating: number;
}
const { rating } = Astro.props;
const clamped = Math.max(0, Math.min(5, Math.round(rating)));
---

<span class="inline-flex gap-0.5 text-accent-500" role="img" aria-label={`${clamped} de 5 estrellas`}>
  {
    Array.from({ length: 5 }, (_, index) => (
      <svg
        class:list={['h-4 w-4', index < clamped ? 'text-accent-500' : 'text-brand-100']}
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z"
          clip-rule="evenodd"
        />
      </svg>
    ))
  }
</span>
