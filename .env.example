# Fuente de datos de la galería/cabañas/slider/reseñas.
#   api      -> siempre el Django REST de Render
#   local    -> siempre los JSON de src/data/
#   firebase -> siempre Firestore (si falla o la colección está vacía, cae a local)
#   fallback -> API primero; si falla o expira, cae a src/data/  (default)
PUBLIC_DATA_SOURCE=fallback

# Opcional: sobrescribe el endpoint base del backend.
PUBLIC_API_BASE_URL=https://entremonte-api-dashboard.onrender.com

# Opcional: timeout de cada petición en ms (build y cliente).
PUBLIC_API_TIMEOUT_MS=5000

# Firebase (web app) — claves públicas del SDK, NO son secretos.
# Se exponen en el bundle del cliente; la protección real son las reglas de
# Firestore/Storage y los dominios autorizados en Firebase Auth.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
# Opcional: habilita Firebase Analytics (solo en navegador).
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudinary — subida "unsigned" de imágenes de la galería (solo admin).
# El preset debe estar en modo Unsigned en Cloudinary → Settings → Upload.
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=

